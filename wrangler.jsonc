// Cloudflare Workers static-assets deployment: no server code, just the built site in dist/.
// Deploy with `npm run deploy` (builds, then runs `wrangler deploy`).
{
  "name": "katarzyna-kardys-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // dyskna.pl is attached as a custom domain in the dashboard (deploys keep it).
  // Another custom domain (after the domain is added to your Cloudflare account), then redeploy:
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "www.example.com", "custom_domain": true }
  // ]
}
